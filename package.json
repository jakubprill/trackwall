{
  "name": "trackwall",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @trackwall/daemon --filter @trackwall/ui dev",
    "build": "pnpm --filter @trackwall/ui build && pnpm --filter @trackwall/daemon build",
    "build:desktop": "pnpm --filter @trackwall/desktop build",
    "portable": "pnpm --filter @trackwall/desktop portable",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check --error-on-warnings . && knip",
    "format": "biome check --write .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "knip": "6.42.1",
    "typescript": "5.9.3"
  }
}
