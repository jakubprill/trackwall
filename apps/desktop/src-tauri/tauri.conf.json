{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trackwall",
  "version": "0.2.0",
  "identifier": "dev.trackwall.desktop",
  "mainBinaryName": "trackwall",
  "build": {
    "frontendDist": "../../../packages/ui/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": {
      "script": "pnpm --filter @trackwall/ui dev",
      "cwd": "../../.."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trackwall",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "transparent": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyNDcxMEYxMENEMDI0NEUKUldST0pOQU04UkJIQWczeVB3d0RELzZiU21JQ3ptNW1uWTNtL3BYYUFybmxYRUEraWtDamd5TE8K",
      "endpoints": ["https://github.com/jakubprill/trackwall/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/trackwall-daemon"],
    "category": "DeveloperTool",
    "shortDescription": "Many repos and many CLI agents in one place",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
