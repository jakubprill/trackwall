{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/target",
      "!**/gen",
      "!**/*.json.tmp",
      "!apps/desktop/src-tauri/icons",
      "!pnpm-lock.yaml",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case", "PascalCase"],
                "requireAscii": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**", "!packages/daemon/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@trackwall/daemon", "@trackwall/daemon/**", "**/daemon/src/**"],
                    "message": "Only the daemon imports its own code; take shared code from @trackwall/protocol (AGENTS.md, module boundaries)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/daemon/src/**", "packages/protocol/src/**", "packages/scene/src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "error"
          }
        }
      }
    },
    {
      "includes": ["packages/daemon/src/**", "!packages/daemon/src/platform/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "Bun APIs only in packages/daemon/src/platform (ADR-1); the rest of the daemon also runs under Node."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [{ "group": ["bun", "bun:*"], "message": "Bun modules only in packages/daemon/src/platform (ADR-1)." }]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/daemon/src/modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["bun", "bun:*"],
                    "message": "Bun modules only in packages/daemon/src/platform (ADR-1)."
                  },
                  {
                    "group": [
                      "../*/**",
                      "!../../infra/errors.ts",
                      "!../../infra/atomic-write.ts",
                      "!../../infra/state-file.ts",
                      "!../../infra/map-limit.ts",
                      "!../../infra/loopback.ts",
                      "!../../infra/env-key.ts",
                      "!../../infra/path-inside.ts",
                      "!../../infra/xml.ts",
                      "!../../infra/glob.ts",
                      "!../../infra/wait-limit.ts",
                      "!../../infra/secret-name.ts",
                      "!../../infra/file-key.ts",
                      "!../../infra/regular-file.ts",
                      "!../../infra/remove-folder.ts",
                      "!../../infra/run-program.ts",
                      "!../../infra/trackwall-dir.ts",
                      "!../../infra/old-trackwall-folders.ts",
                      "!../../platform/**"
                    ],
                    "message": "A module does not import another module; declare the interface you need, and the facade (src/facade.ts) passes the module in (AGENTS.md, §4). A module may take from outside only the listed infrastructure files and src/platform/; a module is a flat directory."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/daemon/src/**", "!packages/daemon/src/modules/**", "!packages/daemon/src/facade.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["bun", "bun:*"],
                    "message": "Bun modules only in packages/daemon/src/platform (ADR-1)."
                  },
                  {
                    "group": ["**/modules/**"],
                    "message": "Transports and infrastructure reach modules only through the facade (src/facade.ts, §4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/daemon/src/platform/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/modules/**"],
                    "message": "Transports and infrastructure reach modules only through the facade (src/facade.ts, §4)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/**", "!packages/ui/src/views/home/HomeCanvas.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@trackwall/daemon", "@trackwall/daemon/**", "**/daemon/src/**"],
                    "message": "Only the daemon imports its own code; take shared code from @trackwall/protocol (AGENTS.md, module boundaries)."
                  },
                  {
                    "group": ["@trackwall/scene"],
                    "message": "Outside the dashboard canvas (HomeCanvas.tsx) take only @trackwall/scene/model from the scene, so that three.js and Pawn stay in a lazily loaded chunk (§5.5)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "alert": "In the Tauri window the dialog plugin replaces alert with a plugin command the page may not call (ADR-51); show the message in the UI.",
                  "confirm": "In the Tauri window the dialog plugin makes confirm return a Promise, which is always truthy (ADR-51); ask in the UI."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/protocol/src/**", "packages/scene/src/**", "packages/ui/src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    }
  ]
}
