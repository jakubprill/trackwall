{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/daemon": {
      "entry": ["test/fixtures/*.ts", "scripts/copilot-record.ts", "scripts/demo/copilot.ts", "contract/*.contract.ts"],
      "ignore": ["test/fixtures/spring/**"]
    },
    "apps/docs": {
      "entry": ["features/*.data.ts"]
    }
  },
  "ignoreIssues": {
    "packages/ui/src/components/ui/*.tsx": ["exports"]
  },
  "ignoreBinaries": ["mise"]
}
