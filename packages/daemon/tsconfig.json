{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The `@xterm/addon-serialize` types (the session screen, ADR-26) pull in `lib.dom` through `@xterm/xterm`; without
    // `DOM.Iterable` the DOM `Headers` from that library shadow the iterable `Headers` of Node and Bun.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "erasableSyntaxOnly": true
  },
  "include": ["src", "test", "scripts", "contract", "e2e"]
}
