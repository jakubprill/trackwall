{
  "name": "@trackwall/daemon",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "bin": {
    "trackwall-daemon": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts --home ../../.trackwall-dev",
    "start": "bun src/main.ts --ui",
    "start:node": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts --ui",
    "build": "bun scripts/build.ts",
    "demo": "bun scripts/demo.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:contract": "bun scripts/contract.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@trackwall/protocol": "workspace:*",
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "smol-toml": "1.9.1",
    "tree-sitter-java": "0.23.5",
    "web-tree-sitter": "0.27.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "1.4.4",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
